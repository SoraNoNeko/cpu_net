<Page x:Class="SetupBootstrapper.Pages.InstallLocationPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="40">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="选择安装位置" FontSize="18" FontWeight="Bold" Margin="0,0,0,20"/>
        <TextBlock Grid.Row="1" Text="CPU_NET 将被安装到以下文件夹：" FontSize="13" Margin="0,0,0,10"/>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox Grid.Column="0" x:Name="PathTextBox" Height="28" VerticalContentAlignment="Center" FontSize="13"
                     TextChanged="PathTextBox_TextChanged"/>
            <Button Grid.Column="1" Content="浏览..." Width="70" Height="28" Margin="10,0,0,0" Click="BrowseButton_Click"/>
        </Grid>

        <TextBlock Grid.Row="3" x:Name="StatusTextBlock" TextWrapping="Wrap" Margin="0,12,0,0" FontSize="12"/>

        <Grid Grid.Row="5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" Content="上一步" Width="100" Height="36" Click="BackButton_Click"/>

            <!-- 正常状态 -->
            <Button Grid.Column="1" Content="安装" Width="100" Height="36" HorizontalAlignment="Right"
                    x:Name="InstallButton" Click="InstallButton_Click"/>

            <!-- 需要管理员权限 -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right"
                        x:Name="AdminPanel" Visibility="Collapsed">
                <Button Content="取消" Width="100" Height="36" Margin="0,0,10,0" Click="CancelAdminButton_Click"/>
                <Button Content="以管理员身份重启" Width="140" Height="36" Click="RestartAsAdminButton_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</Page>
