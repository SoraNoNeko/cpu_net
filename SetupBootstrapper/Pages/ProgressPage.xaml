<Page x:Class="SetupBootstrapper.Pages.ProgressPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="40">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="正在安装 CPU_NET" FontSize="18" FontWeight="Bold" Margin="0,0,0,20"/>

        <ProgressBar Grid.Row="1" Height="22" x:Name="InstallProgressBar"
                     Minimum="0" Maximum="100" Value="0"
                     Margin="0,0,0,12"/>

        <TextBlock Grid.Row="2" x:Name="CurrentStepTextBlock"
                   Text="正在准备安装环境..." FontSize="13" FontWeight="SemiBold"
                   Margin="0,0,0,4"/>

        <TextBlock Grid.Row="3" x:Name="DetailTextBlock"
                   Text="" FontSize="12" Foreground="Gray"
                   Margin="0,0,0,10"/>

        <ScrollViewer Grid.Row="4" VerticalScrollBarVisibility="Auto"
                      x:Name="LogScrollViewer"
                      BorderBrush="#E0E0E0" BorderThickness="1"
                      Background="#FAFAFA">
            <TextBlock x:Name="LogTextBlock"
                       FontSize="11" FontFamily="Consolas"
                       TextWrapping="Wrap"
                       Margin="8"/>
        </ScrollViewer>

        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="下一步" Width="100" Height="36" Margin="0,0,10,0"
                    x:Name="NextButton" Click="NextButton_Click"
                    Visibility="Collapsed" IsEnabled="False"/>
            <Button Content="取消" Width="100" Height="36"
                    x:Name="CancelButton" Click="CancelButton_Click"/>
        </StackPanel>
    </Grid>
</Page>
